# shiroikuma fork: release signing credentials.
#
# The real keystore.properties is GITIGNORED — it carries the signing password in plaintext.
# Copy this file to keystore.properties and fill in the values to produce a signed release APK.
# Without it the build still configures, but the release APK comes out UNSIGNED and will not
# install on the phone.
#
# The 白い熊 keystore for this fork is ~/.android-keystores/shiroikuma-mpvkakucho.jks
# (alias mpvkakucho). Its password is recorded in
#   ~/〇/[666] 私資料/[666][27] 暗号/android-keystores.org
# with a backup copy of the .jks in the android-keystores/ directory next to that file.
# Losing both loses the signing identity — updates could no longer install over an existing app.

storePassword=
keyPassword=
keyAlias=mpvkakucho
storeFile=/home/shiroikuma/.android-keystores/shiroikuma-mpvkakucho.jks
